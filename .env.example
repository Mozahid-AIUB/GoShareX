# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google Authentication
# Get Web Client ID from Firebase Console > Authentication > Google > Web SDK configuration
GOOGLE_WEB_CLIENT_ID=

# Google Maps Platform
# You can use one shared key in GOOGLE_MAPS_API_KEY or split by API below.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=
GOOGLE_DISTANCE_MATRIX_API_KEY=

# App Configuration
APP_ENV=development
APP_VERSION=1.0.0
API_TIMEOUT=30000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true

# Geolocation Settings
LOCATION_UPDATE_INTERVAL=5000
PROXIMITY_RADIUS_METERS=200
GEOFENCE_RADIUS_METERS=100

# Ride Settings
RIDE_CONFIRMATION_TIMEOUT_SECONDS=30
RIDE_WAITING_TIMEOUT_MINUTES=10
AUTO_CANCEL_INACTIVE_MINUTES=5

# Notification Settings
NOTIFICATION_SOUND_ENABLED=true
VIBRATION_ENABLED=true
HIGH_PRIORITY_NOTIFICATIONS=true
