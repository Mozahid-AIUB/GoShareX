rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isRideParticipant() {
      return request.auth != null
          && (request.auth.uid == resource.data.rider1
           || request.auth.uid == resource.data.rider2);
    }

    function isChatParticipant() {
      return request.auth != null
          && request.auth.uid in resource.data.participants;
    }

    function chatData() {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isMessageParticipant(chatId) {
      return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function expectedChatSenderName(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return chat.anonymous == true
        ? chat.participantAliases[request.auth.uid]
        : chat.participantNames[request.auth.uid];
    }

    function isAllowedSystemText() {
      return request.resource.data.text in [
        'Chat started. This conversation will auto-delete in 10 minutes.',
        'Anonymous room created. Waiting for another person to join. Auto-deletes in 5 minutes.',
        'Another anonymous user joined. Chat auto-deletes in 5 minutes.',
        'Anonymous group created. Auto-deletes in 10 minutes.',
        'A new anonymous member joined the group.',
        'An anonymous member left the group.'
      ];
    }

    function isValidChatMessage(chatId) {
      return request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == expectedChatSenderName(chatId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp is number
          && (
            request.resource.data.type == 'text' ||
            request.resource.data.type == 'quick_reply' ||
            request.resource.data.type == 'location' ||
            (request.resource.data.type == 'system' && isAllowedSystemText())
          );
    }

    function allowedParticipantJoin() {
      return resource.data.searching == true
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == resource.data.participants.size() + 1
        && request.resource.data.participants.hasAll(resource.data.participants)
        && request.resource.data.lastMessageTime is number
        && request.resource.data.searching is bool;
    }

    function allowedParticipantLeave() {
      return request.auth.uid in resource.data.participants
        && !(request.auth.uid in request.resource.data.participants)
        && request.resource.data.participants.size() + 1 == resource.data.participants.size()
        && resource.data.participants.hasAll(request.resource.data.participants)
        && request.resource.data.lastMessageTime is number
        && request.resource.data.searching is bool;
    }

    function allowedParticipantUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'lastMessage',
        'lastMessageTime',
        'typing',
        'lastRead',
        'dealConfirmed',
        'expiresAt',
        'closedAt',
        'closedBy',
        'searching'
      ])
        && request.auth.uid in resource.data.participants;
    }

    function isValidUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['isSuspended', 'strikes', 'totalRides', 'rating', 'badge']);
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && isValidUpdate();
      allow delete: if false;
    }

    // ── Active Riders ──────────────────────────────────────────────────────────
    match /active_riders/{userId} {
      allow read:  if isAuth();
      allow write: if isOwner(userId);
    }

    // ── Rides ──────────────────────────────────────────────────────────────────
    match /rides/{rideId} {
      allow read, update: if isAuth() && isRideParticipant();
      allow create:       if isAuth();
      allow delete:       if false;
    }

    // ── Chats ──────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:   if isAuth() && (isChatParticipant() || resource.data.searching == true);
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      // existing participant can update; OR authenticated user can join a searching room
      allow update: if isAuth() && (
        allowedParticipantUpdate() ||
        allowedParticipantJoin() ||
        allowedParticipantLeave()
      );
      allow delete: if isAuth() && isChatParticipant();

      match /messages/{msgId} {
        allow read: if isMessageParticipant(chatId);
        allow create: if isMessageParticipant(chatId) && isValidChatMessage(chatId);
        allow update: if isMessageParticipant(chatId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deletedAt'])
          && request.resource.data.text == '[deleted]'
          && request.resource.data.deletedAt is number;
        allow delete: if isMessageParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Posts ──────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isOwner(request.resource.data.authorId);
      allow update: if isAuth() && isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId);
    }

    // ── Fare Table (read-only) ─────────────────────────────────────────────────
    match /fare_table/{fareId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── Reports (write-only for users) ─────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }

    // ── FCM Tokens ─────────────────────────────────────────────────────────────
    // CRITICAL: Only owner can read their own token (privacy fix)
    // Server-side Cloud Functions have admin access for sending notifications
    match /fcm_tokens/{userId} {
      allow read:  if isOwner(userId);
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Audit Logs (write-only for users) ──────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if isAuth();
      allow read, update, delete: if false;  // Server-side only
    }

    // ── Error Reports & Analytics (write-only) ────────────────────────────────
    match /error_reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }

    // ── Default deny ───────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
