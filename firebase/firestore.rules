rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAIUB() {
      return request.auth != null &&
        request.auth.token.email.matches('.*@aiub\\.edu\\.bd');
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isAIUB();
      allow create: if isOwner(userId) && isAIUB();
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /active_riders/{userId} {
      allow read: if isAIUB();
      allow write: if isOwner(userId) && isAIUB();
    }

    match /rides/{rideId} {
      allow read, update: if isAIUB() &&
        (resource.data.rider1 == request.auth.uid ||
         resource.data.rider2 == request.auth.uid);
      allow create: if isAIUB();
    }

    match /chats/{chatId} {
      allow read, write: if isAIUB() &&
        request.auth.uid in resource.data.participants;
      match /messages/{msgId} {
        allow read, write: if isAIUB() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /posts/{postId} {
      allow read: if isAIUB();
      allow create: if isAIUB();
      allow update: if isOwner(resource.data.authorId);
    }

    match /fare_table/{fareId} {
      allow read: if isAIUB();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isAIUB();
      allow read: if false;
    }
  }
}
